# Add a downloadable binary package
: --name string        # Package Name
: --url string         # Package URL
: --version string     # Package Version
: --description string # Description of package
: --rundeps pkg[]      # Runtime dependencies
: --move string[]      # Filename/glob within the download => Final location.


if [ "${#move[@]}" = 0 ]; then
	echo "Need at least one --move set" >&2;

	exit 1;
fi;

for m in "${move[@]}"; do
	if grep -v -q "=>" <<<"$m"; then
		echo "Invalid move" >&2;

		exit 1;
	fi;
done;

cd "$(mktemp -d)";

mkdir -p "$name-$version/src";

cd "$name-$version/src";

if [ -v git ]; then
	git clone "$git" -C .;

	if [ -v tag ]; then
		git checkout "$tag";
	fi;
else
	declare downloadDir="$(mktemp -d)";

	wget "$url" -O "$downloadDir/source";

	case "$url" in
	*".zip")
		unzip -q "$downloadDir/source" -d .;;
	*)
		tar -xvf "$downloadDir/source" -C .;;
	esac;
fi;

cd ..;

mkdir -p debian/"$name";

cat <<HEREDOC > "debian/control";
Source: $name
Maintainer: $maintainer
Priority: optional
Build-Depends: debhelper-compat (= 13), build-essential$(for dep in "${builddeps[@]}"; do echo -n ", $dep";done)

Package: $name
Architecture: amd64
Depends: \${shlibs:Depends}, \${misc:Depends}$(for dep in "${rundeps[@]}"; do echo -n ", $dep";done)
Description: $description
HEREDOC

cat <<EOF > "debian/changelog";
$name ($version) unstable; urgency=low

  * Built via a Pipeline

 -- $maintainer  $(date -R)

EOF

cat <<EOF > "debian/rules";
#!/usr/bin/make -f
%:
	dh \$@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
EOF

for m in "${move[@]}"; do
	sed -e 's@^ */\?\(.*\) *=> */\?\(.*\) *$@src/\1 \2@' <<< "$m";
done > "debian/install";

find
debuild -us -uc -b;
cd ..

downloadDeps "$PWD";
installDebs "$PWD";

# vim: set filetype=bash :
