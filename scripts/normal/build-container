cat p;
git apply p;
./autogen.sh;
./configure;
make;
make install;
cd ..;
rm -rf s3fs-fuse;

for ver in 4.6.1 4.5.3 4.4.3 4.3.3 4.2.3 4.1.3; do
	wget "https://cdn.posit.co/r/ubuntu-2604/pkgs/r-${ver}_1_amd64.deb"
	chmod 644 ./r-${ver}_1_amd64.deb;
	apt install -y ./r-${ver}_1_amd64.deb;
	rm -f ./r-${ver}_1_amd64.deb;
	/opt/R/$ver/bin/Rscript -e 'Sys.setenv(MAKEFLAGS = sprintf("-j%d", parallel::detectCores() - 1L)); options(repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/resolute/latest")); install.packages("pak"); cmds <- pak::pkg_sysreqs("devtools")$install_scripts; ccmds <- gsub("r-(cran|bioc)-.*", "", cmds); system(ccmds); pak::pkg_install(c("devtools", "remotes", "jsonlite", "BiocManager"))';
done;

mkdir /t;
cd /t;

go mod init repo-http;
cat <<HEREDOC > main.go
package main

import (
	"fmt"
	"net"
	"net/http"
	"os"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)

		os.Exit(1)
	}
}

func run() error {
	l, err := net.Listen("tcp", ":0")
	if err != nil {
		return err
	}

	_, port, err := net.SplitHostPort(l.Addr().String())
	if err != nil {
		return err
	}

	fmt.Println("Listening on:", port)

	return http.Serve(l, http.FileServer(http.Dir("/repo")))
}
HEREDOC

go build;
mv repo-http /usr/bin
cd - &> /dev/null;
rm -rf t;

for bin in "${bins[@]}"; do
	rm -f "$bin"
	dpkg-divert --local --rename --remove "$bin"
done
apt-get clean;

