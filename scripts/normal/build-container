#!/bin/bash
# Build the required softpack container.
: --output string # Output location for singularity container

set -euo pipefail;

trap "trap '' INT; rm -rf ${TMP@Q}" EXIT;

if [ -f "$output" ]; then
	read -r -p "Build target '$output' already exists and will be overwritten. Proceed? [y/N] " response;

	case "$response" in
	y|Y) :;;
	*)
		echo "Build aborted by user";
		exit 1;;
	esac;
elif [ -e "$output" ]; then
	echo "Invalid output target";

	exit 1;
fi;

declare ROOT="$TMP/root";
declare SQFS="$TMP/root.sqfs";
declare SIF="$TMP/singularity.sif";

singularity build --sandbox "$ROOT" "docker://ubuntu:resolute";

export SINGULARITY_ENVIRONMENT=/.singularity.d/env/91-environment.sh;

mkdir -p "$ROOT/.singularity/env";

cat > "$ROOT/.singularity.d/env/91-environment.sh" <<HEREDOC
CFLAGS="-march=x86-64-v3 -O3"
CXXFLAGS="-march=x86-64-v3 -O3"
EXTRA_CFLAGS="-march=x86-64-v3"
LDFLAGS="-Wl,-z,relro"
HEREDOC

chmod 755 "$ROOT/.singularity.d/env/91-environment.sh";

cat > "$ROOT/.singularity/env/99-hack.sh" <<HEREDOC
#!/bin/bash
rm /etc/{passwd,group};
mv /etc/passwd{.orig,};
mv /etc/group{.orig,};
HEREDOC

mv "$ROOT/etc/passwd"{,.orig};
mv "$ROOT/etc/group"{,.orig};
ln -s /etc/passwd.orig "$ROOT/etc/passwd";
ln -s /etc/group.orig "$ROOT/etc/group";

singularity shell --writable --no-home --bind "$(TMPDIR="$TMP" mktemp -d):/tmp" "$ROOT" < <(sed '1,/^exit 0;$/d' < "$0");
rm "$ROOT/.singularity/env/99-hack.sh";

mv "$ROOT"/.singularity.d/env/9{1,0}-environment.sh
mksquashfs "$ROOT" "$SQFS" -all-root;
singularity sif new "$SIF";
singularity sif add --datatype 4 --parttype 1 --partfs 1 --partarch 2 "$SIF" "$SQFS";
singularity sif setprim 1 "$SIF";
mv -f "$SIF" "$output";

exit 0;

export DEBIAN_FRONTEND=noninteractive;
export APT_CONFIG="$(mktemp)";

cat > "$APT_CONFIG" <<HEREDOC
DPkg::Options {
    "--force-not-root";
};
HEREDOC

declare bins=( "/usr/sbin/adduser" "/usr/sbin/addgroup" "/usr/sbin/useradd" "/usr/sbin/groupadd" "/usr/sbin/usermod" "/usr/sbin/groupmod" "/usr/bin/gpasswd" "/usr/bin/systemd-sysusers" "/usr/bin/chown" "/usr/bin/chgrp" "/usr/sbin/dpkg-statoverride" );

for bin in "${bins[@]}"; do
	dpkg-divert --local --rename --add "$bin";
	echo "#!/bin/bash" > "$bin";
	chmod +x "$bin";
	ls -l "$bin";
done

apt update;
apt install -y ca-certificates;

echo "deb [trusted=yes] http://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu/ resolute main" > /etc/apt/sources.list.d/deadsnakes.list;
chmod 644 /etc/apt/sources.list.d/deadsnakes.list;

apt-get update;
apt install -y ca-certificates vim emacs nano file equivs curl wget fuse git s3fs $(apt list 2> /dev/null | grep "^python3\.[0-9]\+\(-dev\|-distutils\|-venv\)\?/" | cut -d'/' -f1) libfuse3-dev build-essential pkg-config libcurl4-openssl-dev libxml2-dev libssl-dev media-types apt-utils xz-utils zstd libdb-dev meson ninja-build libdb5.3++-dev dose-distcheck jq libmagick++-dev libcurl4-openssl-dev libssl-dev libxml2-dev libfontconfig1-dev libharfbuzz-dev libfribidi-dev libsqlite3-dev libpq-dev libhdf5-dev libgdal-dev gdal-bin libproj-dev libgeos-dev libudunits2-dev libgsl-dev libgmp3-dev libmpfr-dev libcairo2-dev libxt-dev libpng-dev libjpeg-dev libtiff-dev xvfb default-jdk libglpk-dev libgl1-mesa-dev libglu1-mesa-dev texlive dctrl-tools jags dh-python db-util debhelper devscripts dpkg-dev golang-go;

for file in /usr/include/tcl/*; do
	ln -s "$file" /usr/include/"$(basename "$file")" || true;
done;

export UV_INSTALL_DIR="/usr/local/bin";
export INSTALLER_NO_MODIFY_PATH=1;
curl -LsSf https://astral.sh/uv/install.sh | bash;

cat > /usr/share/python3/debian_defaults <<HEREDOC
[DEFAULT]
# the default python3 version
default-version = $(basename "$(readlink "$(which python3)")")

# all supported python3 versions
supported-versions = $(find /usr/bin -maxdepth 1 -executable -name "python3.[0-9]*" ! -name "*-config" ! -name "*m" | xargs -L1 basename | tr '\n' ',' | sed -e 's/,/, /g; s/, $//')

# formerly supported python3 versions
old-versions = python3.1, python3.2, python3.3, python3.4, python3.5, python3.6

# unsupported versions, including older versions
unsupported-versions = python3.1, python3.2, python3.3, python3.4, python3.5, python3.6
HEREDOC

sed -i 's/exe = /exe = os.environ.get("UV_PYTHON") or /' /usr/share/dh-python/dhpython/interpreter.py

git clone https://github.com/s3fs-fuse/s3fs-fuse;
cd s3fs-fuse;
git checkout v1.97;
cat > p <<HEREDOC
diff --git a/src/s3fs.cpp b/src/s3fs.cpp
