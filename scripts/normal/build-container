package main

import (
	"errors"
	"fmt"
	"os"
	"slices"
	"strings"

	"pault.ag/go/debian/control"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)

		os.Exit(1)
	}
}

func run() error {
	if len(os.Args)%2 != 0 {
		return errors.New("Usage: controller /path/to/control/file [Field Value]...")
	}

	c, err := control.ParseControlFile(os.Args[1])
	if err != nil {
		return fmt.Errorf("error reading control file: %w", err)
	}

	for k, v := range c.Source.Paragraph.Values {
		c.Source.Paragraph.Values[k] = strings.TrimSpace(v)
	}

	for i := 2; i < len(os.Args); i += 2 {
		if os.Args[i+1] == "" {
			idx := slices.Index(c.Source.Order, os.Args[i])

			if idx >= 0 {
				c.Source.Order = slices.Delete(c.Source.Order, idx, idx+1)
			}
		} else {
			c.Source.Set(os.Args[i], os.Args[i+1])
		}
	}

	f, err := os.Create(os.Args[1])
	if err != nil {
		return fmt.Errorf("error creating control file: %w", err)
	}

	if err = c.Source.WriteTo(f); err != nil {
		return fmt.Errorf("error writing control file: %w", err)
	}

	if err = f.Close(); err != nil {
		return fmt.Errorf("error closing control file: %w", err)
	}

	return nil
}
HEREDOC

