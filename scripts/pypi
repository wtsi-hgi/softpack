# Download a PyPI wheel and wrap it as a deb.
: --python string # Python Version
: --name string # Package Name
: --version string # Package Version
: --buildreqs [string] # Comma seperated list of packages required by (usually legacy) installs

export UV_PYTHON="/usr/bin/python$python";
export DEB_HOST_ARCH="amd64";

if [ ! -x "$UV_PYTHON" ]; then
	echo "Invalid python version" >&2;

	exit 1;
fi;

declare nextPython="$(cut -d'.' -f1 <<< "$python").$(( $(cut -d'.' -f2 <<< "$python") + 1 ))";
declare debs="$(mktemp -d)";

if [ -v buildreqs ]; then
	cd "$(mktemp -d)";

	cat > uv.toml <<-HEREDOC
	[extra-build-dependencies]
	$name = ["$(sed -e 's/,/","/g' <<< "$buildreqs")"]
HEREDOC
fi;


UV_BREAK_SYSTEM_PACKAGES=1 uv pip install --target /usr/lib/python3/dist-packages --compile-bytecode "$name==$version";

while read pkg; do
	if [ "${pkg:0:10}" = "argparse==" ]; then
		continue;
	fi;

	declare name="${pkg/==*/}";
	declare version="${pkg/*==/}~py$python";
	declare tmp="$(mktemp -d)";
	declare pkgName="$(python3 /usr/share/dh-python/dhpython/pydist.py "$name")";
	declare spName="${name//[._]/-}"

	spName="py-${name,,}"

	if [ -z "$pkgName" ]; then
		pkgName="python3-$spName";
	fi;

	cd "$tmp";
	mkdir -p "$tmp/debian/$pkgName";
	mkdir -p "$tmp/DEBIAN";

	if [ -f "$BASE/${pkgName:0:1}/$pkgName-$version.deb" ]; then
		cp "$BASE/${pkgName:0:1}/$pkgName-$version.deb" "$debs";

		continue;
	fi;

	while read file; do
		declare dir="$(dirname "$file")";

		if [ "$dir" = "bin" ]; then
			dir="usr/local/bin";
		else
			dir="usr/lib/python3/dist-packages/$dir";
		fi;

		mkdir -p "$tmp/debian/$pkgName/$dir";
		cp "/usr/lib/python3/dist-packages/$file" "$tmp/debian/$pkgName/$dir";
	done < <(uv pip show --files --target /usr/lib/python3/dist-packages "$name" 2> /dev/null | grep "^  " | sed -e 's/^ *//');

	cat <<-HEREDOC > "$tmp/debian/control";
	Source: $pkgName
	Section: python
	Maintainer: $maintainer
	Priority: optional

	Package: $pkgName
	Architecture: amd64
	Depends: python3 (>= $python), python3 (<< $nextPython), \${python3:Depends}, \${shlibs:Depends}
	Description:$(python3 -c "import sys, email; data = email.message_from_file(sys.stdin); print(data.get('Summary') or data.get_payload())" < "$tmp/debian/$pkgName/usr/lib/python3/dist-packages/"*/METADATA | sed -e 's/^[ \t]*$/./; s/^/ /')
HEREDOC

	cat <<-EOF > "$tmp/debian/changelog";
$pkgName ($version) unstable; urgency=low

  * Built using UV

 -- $maintainer  $(date -R)

EOF

	dpkg-shlibdeps "$tmp/debian/$pkgName/usr/lib/python3/dist-packages"/**/*.so 2> /dev/null || true;
	dh_python3 -p "$pkgName";

	if [ -f "$tmp/debian/"*.substvars ]; then
		cat "$tmp/debian/"*.substvars >> "$tmp/debian/substvars" || true;
	fi;

	dpkg-gencontrol -p"$pkgName" -P"$tmp" -v"$version" -O"$tmp/DEBIAN/control"

	cat <<-HEREDOC >> "$tmp/DEBIAN/control";
	XB-Softpack: true
	XB-Alias: $spName
HEREDOC

	mv "$tmp/DEBIAN" "$tmp/debian/$pkgName/";

	dpkg-deb --root-owner-group --build "$tmp/debian/$pkgName/" "$debs/$pkgName-$version.deb";
done < <(uv pip freeze --target /usr/lib/python3/dist-packages 2> /dev/null);

downloadDeps "$debs";
installDebs "$debs";

# vim: set filetype=bash :
