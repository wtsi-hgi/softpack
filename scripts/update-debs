# Update deb files pulled in from other repos.
: --repo string[] # Repo string to get packages from: deb[-src] http://URL DISTRO COMPONENT

declare tmpDir="$(mktemp -d)";
declare debs="$(mktemp -d)";
declare -a OPTS;

aptOpts "$tmpDir" "$debs" "${repo[@]}";
cp "$tmpDir/etc/apt/sources.list.d/apt.list" "$debs";
cp "$tmpDir/etc/apt/preferences.d/99-local-priority" "$debs";
sed -i 's/990/500/' "$tmpDir/etc/apt/preferences.d/99-local-priority";
sed -i '\@file:///@d; /r2u\.stat\.illinois\.edu/d' "$tmpDir/etc/apt/sources.list.d/apt.list";

apt update "${OPTS[@]}";

declare -a packages=( $(comm -12 <(grep-dctrl -s Package . -n "/repo/dists/resolute/main/binary-amd64/Packages" | sort -u | grep -v "^$") <(apt-cache "${OPTS[@]}" pkgnames | sort -u)) );

mv "$debs/apt.list" "$tmpDir/etc/apt/sources.list.d/apt.list";

apt update "${OPTS[@]}";

cd "$debs";
apt download "${OPTS[@]}" "${packages[@]}";

mv "$debs/99-local-priority" "$tmpDir/etc/apt/preferences.d/99-local-priority";

downloadDeps "$debs";
installDebs "$debs";

# vim: set filetype=bash :
